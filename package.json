{
  "name": "@studio/root",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Booking & Payment Platform monorepo root",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" -r build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" -r test",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" -r lint",
    "lint:root": "eslint . --ext .ts,.tsx,.js,.cjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\"",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" -r typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4"
}
