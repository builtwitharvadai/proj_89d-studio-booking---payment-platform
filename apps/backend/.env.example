# Port the Express server listens on
PORT=3001

# Runtime environment (development | test | production)
NODE_ENV=development

# Allowed origin for CORS requests from the frontend
CORS_ORIGIN=http://localhost:3000

# Application log level (error | warn | info | debug)
LOG_LEVEL=info

# PostgreSQL connection string used by Prisma Client at runtime.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?<params>
DATABASE_URL=postgresql://studio_user:studio_pass@localhost:5432/studio_booking_dev

# Optional direct (non-pooled) connection string for Prisma migrations and
# introspection. Required when DATABASE_URL points at a connection pooler
# such as Supabase's PgBouncer or Neon's pooled endpoint. Leave unset when
# connecting directly to Postgres.
# DIRECT_URL=postgresql://studio_user:studio_pass@localhost:5432/studio_booking_dev
